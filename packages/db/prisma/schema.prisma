  requestId     String    @map("request_id") @db.VarChar(128)
  resource      Resource? @relation("ModerationResource", fields: [resourceId], references: [id], onDelete: Restrict)
  actor         AdminUser? @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

