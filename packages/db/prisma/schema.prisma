}

model ClickEvent {
  id               String    @id @db.Uuid
  resourceId       String    @map("resource_id") @db.Uuid
  cloudLinkId      String    @map("cloud_link_id") @db.Uuid
  providerSlug     String    @map("provider_slug") @db.VarChar(40)
  channelSlug      String?   @map("channel_slug") @db.VarChar(80)
  referrerPageType String?   @map("referrer_page_type") @db.VarChar(80)
  allowedUtmJson   Json?     @map("allowed_utm_json")
  coarseDevice     String?   @map("coarse_device") @db.VarChar(40)
  coarseRegion     String?   @map("coarse_region") @db.VarChar(40)
  dedupeKey        String    @map("dedupe_key") @db.VarChar(128)
  result           String    @db.VarChar(40)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  resource         Resource  @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  cloudLink        CloudLink @relation(fields: [cloudLinkId], references: [id], onDelete: Restrict)

  @@index([createdAt, expiresAt])
  @@index([resourceId, createdAt])
  @@unique([dedupeKey, createdAt])
  @@map("click_events")
}

model ConversionEvent {
  id                String                       @id @db.Uuid
  externalEventKey  String                       @unique @map("external_event_key") @db.VarChar(255)
  providerSlug      String                       @map("provider_slug") @db.VarChar(40)
  resourceId        String?                      @map("resource_id") @db.Uuid
  channelSlug       String?                      @map("channel_slug") @db.VarChar(80)
  conversionType    String                       @map("conversion_type") @db.VarChar(80)
  occurredAt        DateTime                     @map("occurred_at") @db.Timestamptz(6)
  importBatchId     String?                      @map("import_batch_id") @db.Uuid
  sourceDescription String                       @map("source_description") @db.Text
  verificationStatus ConversionVerificationStatus @default(pending) @map("verification_status")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  resource          Resource?                    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  importBatch       ImportBatch?                @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([occurredAt, providerSlug])
  @@map("conversion_events")
}

model DailyAnalytics {
  id           String    @id @db.Uuid
  day          DateTime  @db.Date
  metric       String    @db.VarChar(80)
  providerSlug String?   @map("provider_slug") @db.VarChar(40)
  channelSlug  String?   @map("channel_slug") @db.VarChar(80)
  resourceId   String?   @map("resource_id") @db.Uuid
  value        BigInt
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([day, metric, providerSlug, channelSlug, resourceId])
  @@index([day, metric])
  @@map("daily_analytics")
}

model ImportBatch {
  id             String        @id @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(255)
  format         String        @db.VarChar(40)
  status         ImportStatus  @default(preview)
  requestedBy    String        @map("requested_by") @db.Uuid
  confirmedBy    String?       @map("confirmed_by") @db.Uuid
  rowCount       Int           @default(0) @map("row_count")
  successCount   Int           @default(0) @map("success_count")
  failureCount   Int           @default(0) @map("failure_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  requester      AdminUser     @relation("ImportRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  confirmer      AdminUser?    @relation("ImportConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  rows           ImportRow[]
  conversions    ConversionEvent[]

  @@index([status, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id                String         @id @db.Uuid
  batchId           String         @map("batch_id") @db.Uuid
  rowNumber         Int            @map("row_number")
  sourceHash        String         @map("source_hash") @db.VarChar(128)
  status            ImportRowStatus @default(pending)
  errorCode         String?        @map("error_code") @db.VarChar(80)
  errorDetailRedacted String?      @map("error_detail_redacted") @db.Text
  resourceId        String?        @map("resource_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  batch             ImportBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  resource          Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([sourceHash])
  @@map("import_rows")
}

model OutboxEvent {
  id               String         @id @db.Uuid
  aggregateType    String         @map("aggregate_type") @db.VarChar(80)
  aggregateId      String         @map("aggregate_id") @db.Uuid
  eventType        OutboxEventType @map("event_type")
  payloadVersion   Int            @map("payload_version")
  payloadJson      Json           @map("payload_json")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt      DateTime?      @map("processed_at") @db.Timestamptz(6)
  retryCount       Int            @default(0) @map("retry_count")
  lastErrorRedacted String?       @map("last_error_redacted") @db.Text
  deadLetteredAt   DateTime?      @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([processedAt, retryCount, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model JobFailure {
