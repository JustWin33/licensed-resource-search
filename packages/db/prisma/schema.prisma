generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OwnerType {
  deployer
  authorized_submitter
  third_party_rightsholder
  unknown
}

enum RightsStatus {
  owned
  authorized
  open_licensed
  public_domain
  insufficient_evidence
  revoked
  prohibited
}

enum ReviewStatus {
  pending_review
  needs_changes
  approved
  rejected
}

enum PublicationStatus {
  draft
  published
  temporarily_hidden
  archived
  deleted
}

enum ComplaintStatus {
  none
  under_review
  temporarily_hidden
  restored
  permanently_removed
}

enum LinkStatus {
  pending
  available
  expired
  need_password
  password_error
  risk_controlled
  unsupported
  unknown
  disabled
}

enum SourceType {
  official_site
  author_page
  license_registry
  public_archive
  user_submitted
  other
}

enum CaptureMethod {
  manual
  csv_import
  markdown_import
  official_api
}

enum AuthorizationStatus {
  pending
  active
  expired
  revoked
  rejected
}

enum EvidenceVerificationStatus {
  pending
  verified
  rejected
}

enum SubmissionStatus {
  pending
  needs_info
  approved
  rejected
  withdrawn
}

enum ReportStatus {
  open
  triaged
  resolved
  dismissed
}

enum TakedownStatus {
  received
  temporarily_hidden
  awaiting_response
  restored
  permanently_removed
  closed
}

enum CounterNoticeStatus {
  received
  under_review
  accepted
  rejected
  closed
}

enum HttpResultClass {
  none       @map("none")
  two_xx     @map("2xx")
  three_xx   @map("3xx")
  four_xx    @map("4xx")
  five_xx    @map("5xx")
  network_error
  blocked
}

enum ActorType {
  visitor
  admin_user
  worker
  system
}

enum ImportStatus {
  preview
  confirmed
  processing
  completed
  partial_failure
  failed
  cancelled
}

enum ImportRowStatus {
  pending
  succeeded
  failed
  skipped
}

enum OutboxEventType {
  resource_index_requested
  resource_index_removed
  link_check_requested
  analytics_aggregate_requested
  retention_cleanup_requested
}

enum ConversionVerificationStatus {
  pending
  verified
  rejected
  duplicate
}

model AdminUser {
  id                       String                     @id @db.Uuid
  usernameNormalized       String                     @unique @map("username_normalized") @db.VarChar(120)
  emailNormalized          String?                    @unique @map("email_normalized") @db.VarChar(320)
  passwordHash             String                     @map("password_hash") @db.Text
  passwordHashVersion      String                     @map("password_hash_version") @db.VarChar(32)
  isDisabled               Boolean                    @default(false) @map("is_disabled")
  failedLoginCount         Int                        @default(0) @map("failed_login_count")
  lockedUntil              DateTime?                  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt              DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                  Int                        @default(1)
  roles                    AdminUserRole[]
  sessions                 AdminSession[]
  passwordResetTokens      AdminPasswordResetToken[]
  reviewedResources        Resource[]                  @relation("ResourceReviewer")
  authorizationVerifications AuthorizationRecord[]      @relation("AuthorizationVerifier")
  evidenceUploads          AuthorizationEvidence[]     @relation("EvidenceUploader")
  submissionReviews        Submission[]                @relation("SubmissionReviewer")
  reportHandlers           Report[]                    @relation("ReportHandler")
  takedownHandlers         TakedownRequest[]           @relation("TakedownHandler")
  counterNoticeHandlers    CounterNotice[]             @relation("CounterNoticeHandler")
  blocklistEntries         SourceBlocklist[]            @relation("BlocklistCreator")
  moderationActions        ModerationAction[]           @relation("ModerationActor")
  requestedImports         ImportBatch[]                @relation("ImportRequester")
  confirmedImports         ImportBatch[]                @relation("ImportConfirmer")
  redirectChannelsCreated  RedirectChannel[]            @relation("ChannelCreator")
  systemSettingsUpdated    SystemSetting[]              @relation("SettingUpdater")
  featureFlagsUpdated      FeatureFlag[]                @relation("FlagUpdater")
  auditLogs                AuditLog[]                   @relation("AuditActor")

  @@map("admin_users")
}

model Role {
  id          String            @id @db.Uuid
  slug        String            @unique @db.VarChar(80)
  name        String            @db.VarChar(120)
  description String?           @db.Text
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  slug        String           @unique @db.VarChar(120)
  description String           @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminSession {
  id              String    @id @db.Uuid
  adminUserId     String    @map("admin_user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  ipHmac          String?   @map("ip_hmac") @db.VarChar(128)
  userAgentClass  String?   @map("user_agent_class") @db.VarChar(64)
  adminUser       AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt, expiresAt])
  @@map("admin_sessions")
}

model AdminPasswordResetToken {
  id          String    @id @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt, usedAt])
  @@map("admin_password_reset_tokens")
}

model Resource {
  id                   String                  @id @db.Uuid
  slug                 String                  @db.VarChar(180)
  title                String                  @db.VarChar(300)
  summary              String                  @db.Text
  coverObjectRef       String?                 @map("cover_object_ref") @db.VarChar(500)
  ownerType            OwnerType               @map("owner_type")
  rightsStatus         RightsStatus            @map("rights_status")
  reviewStatus         ReviewStatus            @default(pending_review) @map("review_status")
  publicationStatus    PublicationStatus       @default(draft) @map("publication_status")
  complaintStatus      ComplaintStatus         @default(none) @map("complaint_status")
  completenessScore    Int                     @default(0) @map("completeness_score")
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz(6)
  reviewedBy           String?                 @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewNoteInternal   String?                 @map("review_note_internal") @db.Text
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(6)
  reviewer             AdminUser?              @relation("ResourceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  categories           ResourceCategory[]
  tags                 ResourceTag[]
  sources              ResourceSource[]
  authorizations       AuthorizationRecord[]
  filesSummary         ResourceFilesSummary?
  cloudLinks           CloudLink[]
  submissions          Submission[]
  reports              Report[]
  takedownRequests     TakedownRequest[]
  moderationActions    ModerationAction[]       @relation("ModerationResource")
  clickEvents          ClickEvent[]
  conversionEvents     ConversionEvent[]
  dailyAnalytics       DailyAnalytics[]
  importRows            ImportRow[]

  @@index([publicationStatus, reviewStatus, complaintStatus, deletedAt])
  @@index([updatedAt])
  @@map("resources")
}

model Category {
  id          String             @id @db.Uuid
  slug        String             @unique @db.VarChar(120)
  name        String             @db.VarChar(120)
  parentId    String?            @map("parent_id") @db.Uuid
  isEnabled   Boolean            @default(true) @map("is_enabled")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]         @relation("CategoryTree")
  resources   ResourceCategory[]

  @@map("categories")
}

model ResourceCategory {
  resourceId String   @map("resource_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([resourceId, categoryId])
  @@map("resource_categories")
}

model Tag {
  id             String         @id @db.Uuid
  slug           String         @unique @db.VarChar(120)
  name           String         @db.VarChar(120)
  normalizedName String         @map("normalized_name") @db.VarChar(160)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  resources      ResourceTag[]

  @@map("tags")
}

model ResourceTag {
  resourceId String   @map("resource_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([resourceId, tagId])
  @@map("resource_tags")
}

model ResourceSource {
  id              String       @id @db.Uuid
  resourceId      String       @map("resource_id") @db.Uuid
  sourceUrl       String       @map("source_url") @db.Text
  sourceUrlHash   String       @map("source_url_hash") @db.VarChar(128)
  sourceName      String       @map("source_name") @db.VarChar(200)
  sourceType      SourceType   @map("source_type")
  captureMethod   CaptureMethod @map("capture_method")
  isPublic        Boolean      @default(true) @map("is_public")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource        Resource     @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([resourceId])
  @@unique([sourceUrlHash, resourceId])
  @@map("resource_sources")
}

model AuthorizationRecord {
  id                    String                  @id @db.Uuid
  resourceId            String                  @map("resource_id") @db.Uuid
  rightsType            RightsStatus            @map("rights_type")
  licenseName           String?                 @map("license_name") @db.VarChar(200)
  licenseVersion        String?                 @map("license_version") @db.VarChar(80)
  licenseUrl            String?                 @map("license_url") @db.Text
  grantorNamePrivate    String?                 @map("grantor_name_private") @db.Text
  scopePrivate          String?                 @map("scope_private") @db.Text
  territory             String?                 @db.VarChar(120)
  allowsCommercialPromotion Boolean              @default(false) @map("allows_commercial_promotion")
  startsAt              DateTime?               @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?               @map("ends_at") @db.Timestamptz(6)
  statementPrivate      String?                 @map("statement_private") @db.Text
  verificationBasis    String                  @map("verification_basis") @db.Text
  status                AuthorizationStatus     @default(pending)
  verifiedBy            String?                 @map("verified_by") @db.Uuid
  verifiedAt            DateTime?               @map("verified_at") @db.Timestamptz(6)
  revokedAt             DateTime?               @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource              Resource                @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  verifier              AdminUser?              @relation("AuthorizationVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  evidence              AuthorizationEvidence[]

  @@index([resourceId, status, endsAt])
  @@map("authorization_records")
}

model AuthorizationEvidence {
  id                    String                    @id @db.Uuid
  authorizationRecordId String                    @map("authorization_record_id") @db.Uuid
  objectRefPrivate      String                    @map("object_ref_private") @db.VarChar(500)
  sha256                String                    @db.VarChar(64)
  mimeType              String                    @map("mime_type") @db.VarChar(120)
  byteSize              BigInt                    @map("byte_size")
  originalFilenameRedacted String?                @map("original_filename_redacted") @db.VarChar(255)
  uploadedBy            String                    @map("uploaded_by") @db.Uuid
  verificationStatus    EvidenceVerificationStatus @default(pending) @map("verification_status")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime?                 @map("expires_at") @db.Timestamptz(6)
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  authorizationRecord   AuthorizationRecord       @relation(fields: [authorizationRecordId], references: [id], onDelete: Restrict)
  uploader              AdminUser                 @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([authorizationRecordId, deletedAt])
  @@map("authorization_evidence")
}

model ResourceFilesSummary {
  id              String    @id @db.Uuid
  resourceId      String    @unique @map("resource_id") @db.Uuid
  directorySummary String?  @map("directory_summary") @db.Text
  fileCount       BigInt?   @map("file_count")
  totalBytes      BigInt?   @map("total_bytes")
  sourceName      String?   @map("source_name") @db.VarChar(200)
  observedAt      DateTime? @map("observed_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource        Resource  @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@map("resource_files_summary")
}

model CloudProvider {
  id                 String           @id @db.Uuid
  slug               String           @unique @db.VarChar(40)
  displayName        String           @map("display_name") @db.VarChar(120)
  allowedHostPatterns Json            @map("allowed_host_patterns")
  adapterVersion     String           @map("adapter_version") @db.VarChar(40)
  isEnabled          Boolean          @default(true) @map("is_enabled")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  links              CloudLink[]
  redirectChannels   RedirectChannel[]

  @@map("cloud_providers")
}

model CloudLink {
  id                   String          @id @db.Uuid
  resourceId           String          @map("resource_id") @db.Uuid
  providerId           String          @map("provider_id") @db.Uuid
  normalizedUrl        String          @map("normalized_url") @db.Text
  urlHash              String          @map("url_hash") @db.VarChar(128)
  passcodeCiphertext   String?         @map("passcode_ciphertext") @db.Text
  currentStatus        LinkStatus      @default(pending) @map("current_status")
  statusConfirmations  Int             @default(0) @map("status_confirmations")
  lastCheckedAt        DateTime?       @map("last_checked_at") @db.Timestamptz(6)
  nextCheckAt          DateTime?       @map("next_check_at") @db.Timestamptz(6)
  redirectTemplateId   String?         @map("redirect_template_id") @db.Uuid
  isPrimary            Boolean         @default(false) @map("is_primary")
  isEnabled            Boolean         @default(true) @map("is_enabled")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(6)
  resource             Resource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  provider             CloudProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  redirectTemplate     RedirectChannel? @relation(fields: [redirectTemplateId], references: [id], onDelete: SetNull)
  checkRecords         LinkCheckRecord[]
  clickEvents          ClickEvent[]

  @@index([resourceId, providerId, isEnabled, deletedAt])
  @@index([nextCheckAt, currentStatus])
  @@map("cloud_links")
}

model LinkCheckRecord {
  id                    String          @id @db.Uuid
  cloudLinkId           String          @map("cloud_link_id") @db.Uuid
  adapterVersion        String          @map("adapter_version") @db.VarChar(40)
  status                LinkStatus
  httpResultClass       HttpResultClass  @map("http_result_class")
  errorCategory         String?         @map("error_category") @db.VarChar(80)
  durationMs            Int?            @map("duration_ms")
  checkedAt             DateTime        @map("checked_at") @db.Timestamptz(6)
  nextCheckAt           DateTime?       @map("next_check_at") @db.Timestamptz(6)
  responseMetadataRedacted Json?        @map("response_metadata_redacted")
  cloudLink             CloudLink       @relation(fields: [cloudLinkId], references: [id], onDelete: Restrict)

  @@index([cloudLinkId, checkedAt])
  @@map("link_check_records")
}

model RedirectChannel {
  id                 String          @id @db.Uuid
  slug               String          @unique @db.VarChar(80)
  providerId         String          @map("provider_id") @db.Uuid
  displayName        String          @map("display_name") @db.VarChar(120)
  template           String          @db.Text
  allowedPlaceholders Json           @map("allowed_placeholders")
  isEnabled          Boolean         @default(true) @map("is_enabled")
  createdBy          String          @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider           CloudProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  creator            AdminUser       @relation("ChannelCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  links              CloudLink[]

  @@map("redirect_channels")
}

model Submission {
  id                    String           @id @db.Uuid
  ticketTokenHash       String           @unique @map("ticket_token_hash") @db.VarChar(128)
  title                 String           @db.VarChar(300)
  summary               String           @db.Text
  sourceUrl             String           @map("source_url") @db.Text
  cloudUrl              String           @map("cloud_url") @db.Text
  providerHint          String?          @map("provider_hint") @db.VarChar(40)
  passcodeCiphertext    String?          @map("passcode_ciphertext") @db.Text
  rightsType            RightsStatus     @map("rights_type")
  rightsStatementPrivate String          @map("rights_statement_private") @db.Text
  contactPrivate        String           @map("contact_private") @db.Text
  truthfulnessAcceptedAt DateTime        @map("truthfulness_accepted_at") @db.Timestamptz(6)
  status                SubmissionStatus @default(pending)
  resourceId            String?          @map("resource_id") @db.Uuid
  reviewerId            String?          @map("reviewer_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt             DateTime?        @map("expires_at") @db.Timestamptz(6)
  resource              Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  reviewer              AdminUser?       @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("submissions")
}

model Report {
  id                String      @id @db.Uuid
  ticketTokenHash   String      @unique @map("ticket_token_hash") @db.VarChar(128)
  resourceId        String      @map("resource_id") @db.Uuid
  reasonCode        String      @map("reason_code") @db.VarChar(80)
  descriptionPrivate String     @map("description_private") @db.Text
  contactPrivate    String?     @map("contact_private") @db.Text
  status            ReportStatus @default(open)
  handledBy         String?     @map("handled_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource          Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  handler           AdminUser?  @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([resourceId, status])
  @@map("reports")
}

model TakedownRequest {
  id                    String         @id @db.Uuid
  ticketTokenHash       String         @unique @map("ticket_token_hash") @db.VarChar(128)
  resourceId            String         @map("resource_id") @db.Uuid
  noticeIdentityPrivate String         @map("notice_identity_private") @db.Text
  contactPrivate        String         @map("contact_private") @db.Text
  workOrSourcePrivate   String         @map("work_or_source_private") @db.Text
  requestPrivate        String         @map("request_private") @db.Text
  evidenceRefPrivate    String?        @map("evidence_ref_private") @db.VarChar(500)
  truthfulnessAcceptedAt DateTime      @map("truthfulness_accepted_at") @db.Timestamptz(6)
  status                TakedownStatus @default(received)
  handledBy             String?        @map("handled_by") @db.Uuid
  receivedAt            DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource              Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  handler               AdminUser?     @relation("TakedownHandler", fields: [handledBy], references: [id], onDelete: SetNull)
  counterNotices        CounterNotice[]

  @@index([resourceId, status])
  @@map("takedown_requests")
}

model CounterNotice {
  id                   String             @id @db.Uuid
  takedownRequestId    String             @map("takedown_request_id") @db.Uuid
  submitterContactPrivate String          @map("submitter_contact_private") @db.Text
  statementPrivate     String             @map("statement_private") @db.Text
  evidenceRefPrivate   String?            @map("evidence_ref_private") @db.VarChar(500)
  status               CounterNoticeStatus @default(received)
  handledBy            String?            @map("handled_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  takedownRequest      TakedownRequest    @relation(fields: [takedownRequestId], references: [id], onDelete: Restrict)
  handler              AdminUser?         @relation("CounterNoticeHandler", fields: [handledBy], references: [id], onDelete: SetNull)

  @@index([takedownRequestId, status])
  @@map("counter_notices")
}

model SourceBlocklist {
  id              String    @id @db.Uuid
  kind            String    @db.VarChar(40)
  normalizedValue String    @map("normalized_value") @db.Text
  reasonPrivate   String    @map("reason_private") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator         AdminUser @relation("BlocklistCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([kind, normalizedValue])
  @@index([expiresAt])
  @@map("source_blocklist")
}

