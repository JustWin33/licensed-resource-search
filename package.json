{
  "name": "licensed-resource-search",
  "version": "0.2.0",
  "private": true,
  "description": "合规优先、可审计的授权资料搜索与安全分发平台工程骨架",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.8.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @platform/web --filter @platform/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @platform/db test:integration",
    "db:generate": "pnpm --filter @platform/db prisma:generate",
    "db:migrate": "pnpm --filter @platform/db prisma:migrate",
    "db:seed": "pnpm --filter @platform/db prisma:seed",
    "admin:create": "pnpm --filter @platform/core admin:create",
    "search:smoke": "pnpm --filter @platform/search smoke",
    "search:benchmark": "pnpm --filter @platform/search benchmark",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  }
}
